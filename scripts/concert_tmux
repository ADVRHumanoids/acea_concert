#!/usr/bin/env bash

set -euo pipefail

SESSION="${CONCERT_TMUX_SESSION:-concert}"
MODE="panes"

usage() {
    cat <<'EOF'
Usage: scripts/concert_tmux [--session NAME] [--panes|--windows]

Creates a tmux session with CONCERT terminals ready to launch.
Default: one tiled window with visible panes. Use --windows for tabbed tmux
windows instead.
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --session)
            if [[ $# -lt 2 ]]; then
                echo "error: --session requires a name" >&2
                exit 2
            fi
            SESSION="$2"
            shift 2
            ;;
        --panes)
            MODE="panes"
            shift
            ;;
        --windows)
            MODE="windows"
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "error: unknown argument: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

if ! command -v tmux >/dev/null 2>&1; then
    echo "tmux is not installed. Install it, then run this again:" >&2
    echo "  sudo apt-get update && sudo apt-get install -y tmux" >&2
    exit 127
fi

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="${SCRIPT_DIR}/concert_env.bash"
CONCERT_WS="${CONCERT_WS:-/home/user/concert_ws}"

COMMANDS=(
    "sim:concert_sim"
    "xbot:concert_xbot_gui"
    "gap:concert_gap"
    "gravity:concert_gravity"
    "home:concert_home"
    "drive:concert_drive"
    "controller:concert_controller"
)

attach_session() {
    if [[ -n "${TMUX:-}" ]]; then
        tmux switch-client -t "${SESSION}"
    else
        tmux attach-session -t "${SESSION}"
    fi
}

stage_command() {
    local target="$1"
    local name="$2"
    local command="$3"

    tmux select-pane -t "${target}" -T "${name}"
    tmux send-keys -t "${target}" "CONCERT_ENV_QUIET=1 source '${ENV_FILE}'" C-m
    tmux send-keys -t "${target}" "${command}"
}

create_command_window() {
    local name="$1"
    local command="$2"

    if [[ "${name}" == "sim" ]]; then
        tmux new-session -d -s "${SESSION}" -n "${name}" -c "${CONCERT_WS}" bash
    else
        tmux new-window -t "${SESSION}:" -n "${name}" -c "${CONCERT_WS}" bash
    fi

    stage_command "${SESSION}:${name}" "${name}" "${command}"
}

create_window_layout() {
    local entry

    for entry in "${COMMANDS[@]}"; do
        create_command_window "${entry%%:*}" "${entry#*:}"
    done

    tmux select-window -t "${SESSION}:sim"

    echo "Created tmux session '${SESSION}'. Press Enter in each window in order."
    echo "Windows: sim, xbot, gap, gravity, home, drive, controller"
}

create_pane_layout() {
    local command
    local entry
    local first=1
    local name
    local pane

    tmux new-session -d -s "${SESSION}" -n stack -c "${CONCERT_WS}" bash
    tmux set-option -t "${SESSION}" mouse on >/dev/null
    tmux set-option -t "${SESSION}" pane-border-status top >/dev/null

    for entry in "${COMMANDS[@]}"; do
        name="${entry%%:*}"
        command="${entry#*:}"
        if [[ "${first}" -eq 1 ]]; then
            pane="${SESSION}:stack.0"
            first=0
        else
            pane="$(tmux split-window -P -F '#{pane_id}' -t "${SESSION}:stack" -c "${CONCERT_WS}" bash)"
            tmux select-layout -t "${SESSION}:stack" tiled >/dev/null
        fi
        stage_command "${pane}" "${name}" "${command}"
    done

    tmux select-layout -t "${SESSION}:stack" tiled >/dev/null
    tmux select-window -t "${SESSION}:stack"

    echo "Created tmux session '${SESSION}'. Click a pane and press Enter in order."
    echo "Panes: sim, xbot, gap, gravity, home, drive, controller"
}

if tmux has-session -t "${SESSION}" 2>/dev/null; then
    attach_session
    exit 0
fi

if [[ "${MODE}" == "windows" ]]; then
    create_window_layout
else
    create_pane_layout
fi

attach_session
